# Copy to .env.local for `vercel dev`; on Vercel set them in Project Settings → Environment Variables.
# Supabase Dashboard → Project Settings → API Keys. The publishable key is enough: the database functions
# check the device token and the control panel key themselves (no service role key anywhere).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
